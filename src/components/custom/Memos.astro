---
// MemoDisplay.astro
// 集成了 FullCoverMusicBubble 音乐卡片组件

interface MemoNode {
  type: string;
  paragraphNode?: {
    children: Array<{
      type: string;
      textNode: { content: string };
    }>;
  };
  lineBreakNode?: Record<string, never>;
}

interface Memo {
  name: string;
  content: string;
  createTime: string;
  displayTime: string;
  updateTime: string;
  nodes: MemoNode[];
  visibility: string;
  tags: string[];
  pinned: boolean;
  snippet: string;
  creator?: string;
}

interface MemoResponse {
  memos: Memo[];
  nextPageToken: string;
}

interface MemoDisplayOptions {
  pageSize?: number;
  showTime?: boolean;
  showTags?: boolean;
  showAuthor?: boolean;
  avatarUrl?: string;
  authorName?: string;
}

interface Props {
  options?: MemoDisplayOptions;
}

const { options = {} } = Astro.props;
const defaultOptions: Required<MemoDisplayOptions> = {
  pageSize: 5,
  showTime: true,
  showTags: true,
  showAuthor: true,
  avatarUrl: '',
  authorName: 'Caramel'
};
const config = { ...defaultOptions, ...options };
---

<!-- 组件容器 -->
<div class="memo-display-container" 
     data-page-size={config.pageSize}
     data-show-time={config.showTime}
     data-show-tags={config.showTags}
     data-show-author={config.showAuthor}
     data-avatar-url={config.avatarUrl}
     data-author-name={config.authorName}>
  
  <!-- 头部 -->
  <div class="flex items-center justify-between mb-6">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-full overflow-hidden">
        <img 
          src={config.avatarUrl} 
          alt={config.authorName}
          class="w-full h-full object-cover"
          loading="lazy"
        />
      </div>
      <div>
        <h2 class="text-xl font-bold text-gray-800 dark:text-gray-100">
          {config.authorName}的Memos
        </h2>
        <p class="text-sm text-gray-500 dark:text-gray-400" id="memo-count">
          加载中...
        </p>
      </div>
    </div>
    
    <button 
      onclick="memoApp.refreshMemos()"
      class="px-3 py-2 text-sm bg-gray-100 hover:bg-gray-200 dark:bg-[#2d2d30] dark:hover:bg-[#3d3d40] text-gray-700 dark:text-gray-300 rounded-lg transition-colors flex items-center gap-1 group"
      id="refresh-btn"
      title="刷新备忘录"
    >
      <i class="fas fa-sync text-sm group-hover:rotate-180 transition-transform duration-300"></i>
      刷新
    </button>
  </div>

  <!-- 加载状态 -->
  <div id="loading-state" class="py-12 text-center">
    <div class="inline-flex flex-col items-center gap-4">
      <div class="relative">
        <div class="w-16 h-16 border-4 border-gray-200 dark:border-[#2d2d30] rounded-full"></div>
        <div class="w-16 h-16 border-4 border-blue-400 border-t-transparent rounded-full absolute top-0 left-0 animate-spin"></div>
      </div>
      <div>
        <p class="text-gray-600 dark:text-gray-400 font-medium">正在加载Memos...</p>
        <p class="text-gray-400 dark:text-gray-500 text-sm mt-1">请稍候</p>
      </div>
    </div>
  </div>

  <!-- 错误状态 -->
  <div id="error-state" class="hidden py-12 text-center">
    <div class="inline-flex flex-col items-center gap-4 max-w-md mx-auto">
      <div class="w-20 h-20 bg-red-100 dark:bg-red-900/20 rounded-full flex items-center justify-center">
        <i class="fas fa-exclamation-triangle text-3xl text-red-500 dark:text-red-400"></i>
      </div>
      <div>
        <h3 class="text-lg font-semibold text-gray-800 dark:text-gray-200 mb-2">加载失败</h3>
        <p class="text-gray-600 dark:text-gray-400 mb-6" id="error-message"></p>
        <button 
          onclick="memoApp.refreshMemos()"
          class="px-5 py-2.5 bg-blue-400 hover:bg-blue-500 dark:bg-blue-400 dark:hover:bg-blue-500 text-white rounded-lg transition-colors flex items-center gap-2 mx-auto"
        >
          <i class="fas fa-redo"></i>
          重新加载
        </button>
      </div>
    </div>
  </div>

  <!-- 空状态 -->
  <div id="empty-state" class="hidden py-12 text-center">
    <div class="inline-flex flex-col items-center gap-4">
      <div class="w-20 h-20 bg-gray-100 dark:bg-[#2d2d30] rounded-full flex items-center justify-center">
        <i class="fas fa-sticky-note text-3xl text-gray-400 dark:text-gray-500"></i>
      </div>
      <div>
        <p class="text-gray-600 dark:text-gray-400 font-medium">暂无Memos</p>
        <p class="text-gray-400 dark:text-gray-500 text-sm mt-1">点击刷新按钮获取最新内容</p>
      </div>
    </div>
  </div>

  <!-- 备忘录列表 -->
  <div id="memo-list" class="space-y-5"></div>

  <!-- 分页控制 -->
  <div id="pagination-controls" class="hidden mt-8 pt-6 border-t border-gray-200 dark:border-[#2d2d30]">
    <div class="flex flex-col items-center gap-4">
      <div class="text-sm text-gray-500 dark:text-gray-400">
        已显示 <span id="current-count" class="font-semibold text-gray-700 dark:text-gray-300">0</span> 条Memos
      </div>
      <button 
        onclick="memoApp.loadMoreMemos()"
        class="px-3 py-2 text-sm bg-gray-100 hover:bg-gray-200 dark:bg-[#2d2d30] dark:hover:bg-[#3d3d40] text-gray-700 dark:text-gray-300 rounded-lg transition-colors flex items-center gap-1 group"
        id="load-more-btn"
      >
        <i class="fas fa-plus group-hover:rotate-90 transition-transform duration-300"></i>
        加载更多
      </button>
    </div>
  </div>
</div>

<!-- FullCoverMusicBubble 组件样式 -->
<style is:global>
  /* FullCoverMusicBubble 组件样式 */
  .music-bubble-full {
    position: relative;
    overflow: hidden;
    border-radius: 1rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    max-width: 420px;
    width: 100%;
    height: 200px;
    color: white;
    background-color: #1a1a1a;
  }

  .music-bubble-full * {
    box-sizing: border-box;
  }

  .music-bubble-full .cover-layer {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: flex-end;
    z-index: 1;
  }

  .music-bubble-full .cover-layer .cover-image {
    height: 100%;
    object-fit: cover;
    display: block;
    margin-right: 0%;
  }

  .music-bubble-full .color-overlay {
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    background: linear-gradient(90deg, var(--theme-color, #3b82f6) 0%, var(--theme-color, #3b82f6) 40%, transparent 100%);
  }

  .music-bubble-full .content-layer {
    position: relative;
    z-index: 20;
    padding: 1rem;
    width: 100%;
  }

  .music-bubble-full .track-title {
    font-size: 1.25rem;
    line-height: 1.4;
    margin: 0 0 0.1rem 0;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--accent-color, #fbbf24);
  }

  .music-bubble-full .track-artist {
    font-size: 0.875rem;
    line-height: 1.4;
    margin: 0 0 0.5rem 0;
    opacity: 0.9;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--accent-color, #fbbf24);
  }

  @media (min-width: 768px) {
    .music-bubble-full .track-title { font-size: 1.5rem; }
    .music-bubble-full .track-artist { font-size: 1rem; }
  }

  .music-bubble-full .controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .music-bubble-full .ctrl-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 9999px;
    background-color: rgba(255,255,255,0.1);
    color: var(--accent-color, #fbbf24);
    cursor: default;
    opacity: 0.9;
    transition: none;
    width: 1.5rem;
    height: 1.5rem;
    font-size: 0.75rem;
    line-height: 1;
  }

  .music-bubble-full .play-btn {
    width: 2rem;
    height: 2rem;
    font-size: 1rem;
    background-color: rgba(255,255,255,0.2);
  }

  .music-bubble-full .progress-wrapper {
    width: 100%;
    margin-top: 0.25rem;
  }

  .music-bubble-full .progress-track {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }

  .music-bubble-full .progress-bg {
    width: 100%;
    height: 0.25rem;
    border-radius: 9999px;
    overflow: hidden;
    background-color: var(--theme-color, #3b82f6);
    opacity: 0.3;
  }

  .music-bubble-full .progress-fill {
    height: 100%;
    background-color: var(--accent-color, #fbbf24);
    transition: width 0.3s ease;
    box-shadow: 0 0 8px rgba(255,255,255,0.3);
  }

  .music-bubble-full .progress-knob {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 9999px;
    background-color: var(--accent-color, #fbbf24);
    box-shadow: 0 2px 6px rgba(0,0,0,0.2);
    transition: left 0.3s ease;
    z-index: 25;
  }

  .music-bubble-full .time-labels {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    color: rgba(255,255,255,0.8);
    margin-top: 0.15rem;
  }

  .music-bubble-full .deco-notes {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    font-size: 1.5rem;
    line-height: 1;
    color: rgba(255,255,255,0.3);
    user-select: none;
    pointer-events: none;
    z-index: 20;
  }

  .music-bubble-full button[disabled] {
    pointer-events: none;
    opacity: 0.9;
  }

  @media (max-width: 480px) {
    .music-bubble-full { height: 180px; }
    .music-bubble-full .track-title { font-size: 1rem; }
    .music-bubble-full .track-artist { font-size: 0.75rem; }
  }

  /* 原有样式 */
  :root {
    --bg-light: #ffffff;
    --bg-dark: #1d1d20;
    --card-light: #ffffff;
    --card-dark: #1d1d20;
    --border-light: #e5e7eb;
    --border-dark: #2d2d30;
    --text-light: #374151;
    --text-dark: #e5e7eb;
    --text-secondary-light: #6b7280;
    --text-secondary-dark: #9ca3af;
  }

  .memo-card {
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    animation: cardEntrance 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    border: 1px solid var(--border-light);
    margin-bottom: 8px;
  }

  @media (prefers-color-scheme: dark) {
    .memo-card {
      background-color: var(--card-dark);
    }
  }

  .memo-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
  }

  .memo-content {
    white-space: pre-wrap;
    word-break: break-word;
    line-height: 1.7;
  }

  @media (prefers-color-scheme: dark) {
    .memo-time {
      color: var(--text-secondary-dark);
    }
  }

  .tag-item {
    transition: all 0.2s ease;
    background: linear-gradient(135deg, #8b5cf6 0%, #6366f1 100%);
    color: white;
    font-weight: 500;
  }

  .tag-item:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(139, 92, 246, 0.3);
  }

  @keyframes cardEntrance {
    from {
      opacity: 0;
      transform: translateY(20px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .load-more-btn {
    background: linear-gradient(135deg, #8b5cf6 0%, #6366f1 100%);
    transition: all 0.3s ease;
  }

  .load-more-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(139, 92, 246, 0.4);
  }

  .load-more-btn:disabled {
    background: linear-gradient(135deg, #c7d2fe 0%, #a5b4fc 100%);
    transform: none;
    box-shadow: none;
  }

  @media (prefers-color-scheme: dark) {
    .load-more-btn {
      background: linear-gradient(135deg, #7c3aed 0%, #4f46e5 100%);
    }
    
    .load-more-btn:hover {
      box-shadow: 0 10px 25px rgba(124, 58, 237, 0.4);
    }
    
    .load-more-btn:disabled {
      background: linear-gradient(135deg, #4c1d95 0%, #3730a3 100%);
    }
  }
</style>

<script is:inline>
class MemoApp {
  constructor() {
    /** @type {Memo[]} */
    this.memos = [];
    this.nextPageToken = '';
    this.isLoading = false;
    this.hasMore = true;
    this.currentCount = 0;
    
    // 从容器元素获取配置
    const container = document.querySelector('.memo-display-container');
    this.pageSize = parseInt(container?.dataset.pageSize || '5');
    this.showTime = container?.dataset.showTime === 'true';
    this.showTags = container?.dataset.showTags === 'true';
    this.showAuthor = container?.dataset.showAuthor === 'true';
    this.avatarUrl = container?.dataset.avatarUrl || '';
    this.authorName = container?.dataset.authorName || '作者';
  }
  
  // DOM 操作辅助方法
  showElement(id) {
    document.getElementById(id)?.classList.remove('hidden');
  }
  
  hideElement(id) {
    document.getElementById(id)?.classList.add('hidden');
  }
  
  setButtonState(buttonId, enabled, text = null) {
    const button = document.getElementById(buttonId);
    if (!button) return;
    
    button.disabled = !enabled;
    if (text !== null) {
      button.innerHTML = text;
    }
  }
  
  // 格式化日期
  formatDate(dateString) {
    const date = new Date(dateString);
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, '0');
    const day = String(date.getDate()).padStart(2, '0');
    return `${year}/${month}/${day}`;
  }
  
  formatFullDateTime(dateString) {
    const date = new Date(dateString);
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, '0');
    const day = String(date.getDate()).padStart(2, '0');
    const hours = String(date.getHours()).padStart(2, '0');
    const minutes = String(date.getMinutes()).padStart(2, '0');
    return `${year}/${month}/${day} ${hours}:${minutes}`;
  }
  
  getRelativeTime(dateString) {
    const date = new Date(dateString);
    const now = new Date();
    const diffMs = now - date;
    const diffHours = Math.floor(diffMs / 3600000);
    const diffDays = Math.floor(diffMs / 86400000);
    
    if (diffHours < 1) return '1小时内';
    if (diffHours < 24) return `${diffHours}小时前`;
    if (diffDays === 1) return '昨天';
    if (diffDays < 7) return `${diffDays}天前`;
    return this.formatDate(dateString);
  }
  
  /**
   * 解析音乐卡片配置
   * @param {string} content - 备忘录内容
   * @returns {MusicCardConfig|null}
   */
  parseMusicCard(content) {
    if (!content.trim().startsWith('[music]')) {
      return null;
    }

    try {
      const configStr = content.replace('[music]', '').trim();
      const lines = configStr.split('\n').filter(line => line.trim());
      const config = {};
      
      for (const line of lines) {
        const match = line.match(/^([a-zA-Z0-9_]+)\s*=\s*['"]?([^'"]*)['"]?$/);
        if (match) {
          const [, key, value] = match;
          config[key] = value.trim();
        }
      }
      
      if (!config.coverUrl || !config.title || !config.artist) {
        console.warn('音乐卡片配置缺少必要字段');
        return null;
      }
      
      return {
        coverUrl: config.coverUrl,
        title: config.title,
        artist: config.artist,
        alt: config.alt || '音乐封面',
        progress: parseInt(config.progress) || 45,
        isPlaying: config.isPlaying === 'true'
      };
    } catch (error) {
      console.error('解析音乐卡片配置失败:', error);
      return null;
    }
  }
  
  /**
   * 创建 FullCoverMusicBubble 音乐卡片
   * @param {MusicCardConfig} config - 音乐卡片配置
   * @returns {HTMLElement}
   */
  createMusicCard(config) {
    const wrapper = document.createElement('div');
    wrapper.className = 'memo-card p-0 overflow-hidden bg-transparent border-none hover:shadow-none';
    
    // 创建音乐气泡容器
    const bubble = document.createElement('div');
    bubble.className = 'music-bubble-full';
    bubble.id = `music-bubble-${Date.now()}-${Math.random()}`;
    
    // 封面层
    const coverLayer = document.createElement('div');
    coverLayer.className = 'cover-layer';
    const img = document.createElement('img');
    img.className = 'cover-image';
    img.src = config.coverUrl;
    img.alt = config.alt || '音乐封面';
    img.crossOrigin = 'anonymous';
    img.loading = 'lazy';
    img.id = `cover-image-${Date.now()}`;
    coverLayer.appendChild(img);
    bubble.appendChild(coverLayer);
    
    // 颜色覆盖层
    const overlay = document.createElement('div');
    overlay.className = 'color-overlay';
    overlay.id = `color-overlay-${Date.now()}`;
    bubble.appendChild(overlay);
    
    // 内容层
    const content = document.createElement('div');
    content.className = 'content-layer';
    
    // 文字信息
    const titleEl = document.createElement('h3');
    titleEl.className = 'track-title';
    titleEl.textContent = config.title;
    
    const artistEl = document.createElement('p');
    artistEl.className = 'track-artist';
    artistEl.textContent = config.artist;
    
    // 控制按钮
    const controls = document.createElement('div');
    controls.className = 'controls';
    
    const prevBtn = document.createElement('button');
    prevBtn.className = 'ctrl-btn';
    prevBtn.setAttribute('aria-label', '上一首');
    prevBtn.disabled = true;
    prevBtn.innerHTML = '<span aria-hidden="true">⏮</span>';
    controls.appendChild(prevBtn);
    
    const playBtn = document.createElement('button');
    playBtn.className = 'ctrl-btn play-btn';
    playBtn.setAttribute('aria-label', config.isPlaying ? '暂停' : '播放');
    playBtn.disabled = true;
    playBtn.innerHTML = `<span aria-hidden="true">${config.isPlaying ? '⏸︎' : '▶'}</span>`;
    controls.appendChild(playBtn);
    
    const nextBtn = document.createElement('button');
    nextBtn.className = 'ctrl-btn';
    nextBtn.setAttribute('aria-label', '下一首');
    nextBtn.disabled = true;
    nextBtn.innerHTML = '<span aria-hidden="true">⏭</span>';
    controls.appendChild(nextBtn);
    
    // 进度条
    const progressWrapper = document.createElement('div');
    progressWrapper.className = 'progress-wrapper';
    
    const track = document.createElement('div');
    track.className = 'progress-track';
    
    const bg = document.createElement('div');
    bg.className = 'progress-bg';
    bg.id = `progress-bg-${Date.now()}`;
    
    const fill = document.createElement('div');
    fill.className = 'progress-fill';
    fill.id = `progress-fill-${Date.now()}`;
    fill.style.width = config.progress + '%';
    bg.appendChild(fill);
    
    const knob = document.createElement('div');
    knob.className = 'progress-knob';
    knob.id = `progress-knob-${Date.now()}`;
    knob.style.left = config.progress + '%';
    track.appendChild(bg);
    track.appendChild(knob);
    
    const timeLabels = document.createElement('div');
    timeLabels.className = 'time-labels';
    timeLabels.innerHTML = '<span>1:24</span><span>-3:02</span>';
    
    progressWrapper.appendChild(track);
    progressWrapper.appendChild(timeLabels);
    
    content.appendChild(titleEl);
    content.appendChild(artistEl);
    content.appendChild(controls);
    content.appendChild(progressWrapper);
    bubble.appendChild(content);
    
    // 装饰音符
    const notes = document.createElement('div');
    notes.className = 'deco-notes';
    notes.textContent = '♪♪';
    bubble.appendChild(notes);
    
    wrapper.appendChild(bubble);
    
    // 颜色提取
    this.extractColorsForMusicCard(img, overlay, bubble, fill, knob, bg, [prevBtn, playBtn, nextBtn], titleEl, artistEl);
    
    return wrapper;
  }
  
  /**
   * 提取颜色并应用到音乐卡片
   */
  async extractColorsForMusicCard(img, overlay, bubble, progressFill, progressKnob, progressBg, controlBtns, titleEl, artistEl) {
    try {
      // 动态导入 ColorThief
      const module = await import('https://unpkg.com/colorthief@2.3.2/dist/color-thief.mjs');
      const ColorThief = module.default;
      
      const extractAndApply = () => {
        try {
          const colorThief = new ColorThief();
          const dominant = colorThief.getColor(img);
          const palette = colorThief.getPalette(img, 8);
          
          if (dominant) {
            const [r, g, b] = dominant;
            const theme = `rgb(${r}, ${g}, ${b})`;
            bubble.style.setProperty('--theme-color', theme);
            overlay.style.background = `linear-gradient(90deg, ${theme} 0%, ${theme} 40%, transparent 100%)`;
            progressBg.style.backgroundColor = theme;
          }
          
          if (palette && palette.length > 1) {
            const [r, g, b] = palette[1];
            const accent = `rgb(${r}, ${g}, ${b})`;
            bubble.style.setProperty('--accent-color', accent);
            titleEl.style.color = accent;
            artistEl.style.color = accent;
            progressFill.style.backgroundColor = accent;
            progressKnob.style.backgroundColor = accent;
            controlBtns.forEach(btn => { btn.style.color = accent; });
          }
        } catch (err) {
          console.warn('Color extraction failed:', err);
          this.applyFallbackColors(bubble, overlay, progressBg, titleEl, artistEl, progressFill, progressKnob, controlBtns);
        }
      };
      
      if (img.complete) {
        extractAndApply();
      } else {
        img.addEventListener('load', extractAndApply);
        img.addEventListener('error', () => {
          this.applyFallbackColors(bubble, overlay, progressBg, titleEl, artistEl, progressFill, progressKnob, controlBtns);
        });
      }
    } catch (error) {
      console.warn('ColorThief loading failed:', error);
      this.applyFallbackColors(bubble, overlay, progressBg, titleEl, artistEl, progressFill, progressKnob, controlBtns);
    }
  }
  
  /**
   * 应用回退颜色
   */
  applyFallbackColors(bubble, overlay, progressBg, titleEl, artistEl, progressFill, progressKnob, controlBtns) {
    const fallbackTheme = '#3b82f6';
    const fallbackAccent = '#fbbf24';
    
    bubble.style.setProperty('--theme-color', fallbackTheme);
    bubble.style.setProperty('--accent-color', fallbackAccent);
    overlay.style.background = `linear-gradient(90deg, ${fallbackTheme} 0%, ${fallbackTheme} 40%, transparent 100%)`;
    progressBg.style.backgroundColor = fallbackTheme;
    titleEl.style.color = fallbackAccent;
    artistEl.style.color = fallbackAccent;
    progressFill.style.backgroundColor = fallbackAccent;
    progressKnob.style.backgroundColor = fallbackAccent;
    controlBtns.forEach(btn => { btn.style.color = fallbackAccent; });
  }
  
  // 创建普通备忘录卡片
  createMemoCard(memo) {
    // 检测是否为音乐卡片
    const musicConfig = this.parseMusicCard(memo.content);
    
    if (musicConfig) {
      return this.createMusicCard(musicConfig);
    }
    
    // 普通卡片
    const card = document.createElement('div');
    card.className = 'memo-card p-5 bg-white dark:bg-[#1d1d20] border-[#e5e7eb] dark:border-[#2d2d30]';
    
    // 卡片头部
    const header = document.createElement('div');
    header.className = 'flex items-start justify-between mb-4';
    
    const authorSection = document.createElement('div');
    authorSection.className = 'flex items-center gap-3';
    
    if (this.showAuthor) {
      const avatarContainer = document.createElement('div');
      avatarContainer.className = 'author-avatar w-12 h-12 rounded-full overflow-hidden flex-shrink-0';
      
      const avatar = document.createElement('img');
      avatar.src = this.avatarUrl;
      avatar.alt = this.authorName;
      avatar.className = 'w-full h-full object-cover';
      avatar.loading = 'lazy';
      avatarContainer.appendChild(avatar);
      
      const authorInfo = document.createElement('div');
      
      const authorNameEl = document.createElement('div');
      authorNameEl.className = 'font-semibold text-gray-800 dark:text-gray-200';
      authorNameEl.textContent = this.authorName;
      
      const relativeTime = document.createElement('div');
      relativeTime.className = 'text-xs text-gray-500 dark:text-gray-400';
      relativeTime.textContent = this.getRelativeTime(memo.createTime);
      relativeTime.title = this.formatFullDateTime(memo.createTime);
      
      authorInfo.appendChild(authorNameEl);
      authorInfo.appendChild(relativeTime);
      
      authorSection.appendChild(avatarContainer);
      authorSection.appendChild(authorInfo);
    }
    
    const rightSection = document.createElement('div');
    rightSection.className = 'flex items-center gap-2';
    
    if (this.showTime) {
      const timeDiv = document.createElement('div');
      timeDiv.className = 'flex flex-col items-end';
      
      const timeText = document.createElement('span');
      timeText.className = 'memo-time';
      timeText.textContent = this.formatDate(memo.createTime);
      timeText.title = this.formatFullDateTime(memo.createTime);
      
      timeDiv.appendChild(timeText);
      rightSection.appendChild(timeDiv);
    }
    
    if (memo.pinned) {
      const pinnedBadge = document.createElement('span');
      pinnedBadge.className = 'px-2 py-1 bg-yellow-100 dark:bg-yellow-900 text-yellow-800 dark:text-yellow-200 text-xs rounded-full flex items-center gap-1';
      pinnedBadge.innerHTML = '<i class="fas fa-thumbtack"></i> 置顶';
      rightSection.appendChild(pinnedBadge);
    }
    
    header.appendChild(authorSection);
    header.appendChild(rightSection);
    
    // 内容区域
    const contentDiv = document.createElement('div');
    contentDiv.className = 'mb-4';
    
    const content = document.createElement('div');
    content.className = 'memo-content leading-relaxed text-gray-800 dark:text-gray-200 text-[16px]';
    
    const lines = memo.content.split('\n');
    lines.forEach((line, index) => {
      if (line.trim()) {
        const paragraph = document.createElement('p');
        paragraph.textContent = line;
        if (index < lines.length - 1) {
          paragraph.classList.add('mb-3');
        }
        content.appendChild(paragraph);
      }
    });
    
    contentDiv.appendChild(content);
    
    // 标签区域
    let footer = null;
    if (this.showTags && memo.tags && memo.tags.length > 0) {
      footer = document.createElement('div');
      footer.className = 'pt-4 border-t border-gray-100 dark:border-[#2d2d30]';
      
      const tagsContainer = document.createElement('div');
      tagsContainer.className = 'flex flex-wrap gap-2';
      
      memo.tags.forEach(tag => {
        const tagSpan = document.createElement('span');
        tagSpan.className = 'tag-item px-3 py-1.5 text-xs rounded-full cursor-pointer';
        tagSpan.textContent = `#${tag}`;
        tagSpan.title = `标签: ${tag}`;
        tagSpan.onclick = (e) => {
          e.stopPropagation();
          console.log(`点击标签: ${tag}`);
        };
        tagsContainer.appendChild(tagSpan);
      });
      
      footer.appendChild(tagsContainer);
    }
    
    card.appendChild(header);
    card.appendChild(contentDiv);
    if (footer) card.appendChild(footer);
    
    return card;
  }
  
  // 渲染备忘录列表
  renderMemoList() {
    const memoList = document.getElementById('memo-list');
    if (!memoList) return;
    
    if (this.currentCount === this.pageSize) {
      memoList.innerHTML = '';
    }
    
    const startIndex = Math.max(0, this.memos.length - this.pageSize);
    const newMemos = this.memos.slice(startIndex);
    
    newMemos.forEach((memo, index) => {
      const card = this.createMemoCard(memo);
      card.style.animationDelay = `${index * 0.1}s`;
      memoList.appendChild(card);
    });
  }
  
  // 获取备忘录数据
  async fetchMemos(pageToken = '') {
    try {
      this.isLoading = true;
      this.hideElement('error-state');
      
      if (pageToken === '') {
        this.showElement('loading-state');
        this.hideElement('pagination-controls');
        this.memos = [];
      } else {
        this.setButtonState('load-more-btn', false, '<i class="fas fa-spinner fa-spin"></i> 加载中...');
      }
      
      let url = `https://shoujo-rococo.hf.space/api/v1/memos?creatorId=1&pageSize=${this.pageSize}`;
      if (pageToken) {
        url += `&pageToken=${encodeURIComponent(pageToken)}`;
      }
      
      const response = await fetch(url);
      
      if (!response.ok) {
        throw new Error(`请求失败: ${response.status}`);
      }
      
      /** @type {MemoResponse} */
      const data = await response.json();
      
      if (pageToken === '') {
        this.memos = data.memos;
      } else {
        this.memos = [...this.memos, ...data.memos];
      }
      
      this.nextPageToken = data.nextPageToken;
      this.hasMore = !!data.nextPageToken;
      this.currentCount = this.memos.length;
      
      this.renderMemoList();
      this.updateDisplayState();
      
    } catch (error) {
      console.error('获取备忘录失败:', error);
      this.showElement('error-state');
      const errorMsg = document.getElementById('error-message');
      if (errorMsg) {
        errorMsg.textContent = error.message || '无法连接到服务器，请检查网络连接';
      }
      
    } finally {
      this.isLoading = false;
      this.hideElement('loading-state');
      this.setButtonState('load-more-btn', true, 
        this.hasMore ? '<i class="fas fa-plus group-hover:rotate-90 transition-transform duration-300"></i> 加载更多' : '<i class="fas fa-check"></i> 已加载全部');
    }
  }
  
  // 更新显示状态
  updateDisplayState() {
    const currentCount = document.getElementById('current-count');
    const memoCount = document.getElementById('memo-count');
    const memoList = document.getElementById('memo-list');
    
    if (!currentCount || !memoCount || !memoList) return;
    
    if (this.memos.length === 0) {
      this.showElement('empty-state');
      this.hideElement('pagination-controls');
      memoCount.textContent = '暂无备忘录';
      return;
    }
    
    this.hideElement('empty-state');
    this.showElement('pagination-controls');
    
    currentCount.textContent = this.currentCount.toString();
    memoCount.textContent = `已加载 ${this.currentCount} 条备忘录`;
    
    this.setButtonState('load-more-btn', this.hasMore && !this.isLoading, 
      this.hasMore ? '<i class="fas fa-plus group-hover:rotate-90 transition-transform duration-300"></i> 加载更多' : '<i class="fas fa-check"></i> 已加载全部');
  }
  
  // 加载更多备忘录
  async loadMoreMemos() {
    if (this.isLoading || !this.hasMore) return;
    await this.fetchMemos(this.nextPageToken);
  }
  
  // 刷新备忘录
  async refreshMemos() {
    const refreshBtn = document.getElementById('refresh-btn');
    if (refreshBtn) {
      refreshBtn.innerHTML = '<i class="fas fa-spinner fa-spin text-sm"></i>';
      refreshBtn.disabled = true;
    }
    
    try {
      await this.fetchMemos('');
    } finally {
      if (refreshBtn) {
        refreshBtn.innerHTML = '<i class="fas fa-sync text-sm group-hover:rotate-180 transition-transform duration-300"></i>刷新';
        refreshBtn.disabled = false;
      }
    }
  }
  
  // 初始化应用
  init() {
    this.fetchMemos('');
  }
}

// 创建应用实例
const memoApp = new MemoApp();

// 页面加载时初始化
document.addEventListener('DOMContentLoaded', () => {
  memoApp.init();
});

// 将应用实例暴露给全局
window.memoApp = memoApp;
</script>
